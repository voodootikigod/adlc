    "./lib/deny-lifecycle.mjs": "./lib/deny-lifecycle.mjs",
    "./lib/deny-marker.mjs": "./lib/deny-marker.mjs",
    "./lib/paths.mjs": "./lib/paths.mjs",
    "./lib/final.mjs": "./lib/final.mjs",
    "./lib/lock.mjs": "./lib/lock.mjs",
    "./lib/resume-auth.mjs": "./lib/resume-auth.mjs",
    "./lib/deny-persist.mjs": "./lib/deny-persist.mjs"
  },
  "dependencies": {
    "@adlc/core": "1.8.0",
    "@adlc/gate-manifest": "1.8.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs cli-test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
