{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/voodootikigod/adlc/packages/decision-layer/schemas/DecisionPack.schema.json",
  "title": "DecisionPack",
  "description": "A versioned question pack for @adlc/decision-layer (shadow mode). lib/pack.mjs validates the same rules without a schema engine, plus the cross-references a schema cannot express: question inputs must be declared, aggregation conditions must name a question and stay inside its domain, and question IDs must be unique.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "mode", "limits", "inputs", "questions", "aggregation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "mode": { "const": "shadow" },
    "description": { "type": "string" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldBytes", "totalBytes"],
      "properties": {
        "fieldBytes": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "totalBytes": { "type": "integer", "minimum": 1, "maximum": 32768 }
      }
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "type", "classification", "maxBytes"],
        "properties": {
          "source": { "enum": ["git-diff", "ticket-store"] },
          "type": { "enum": ["integer", "string", "count-map", "integer-or-none"] },
          "classification": { "const": "metadata" },
          "maxBytes": { "type": "integer", "minimum": 1, "maximum": 4096 }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "domain", "phases", "inputs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["Choice", "Score", "Noul"] },
          "prompt": { "type": "string" },
          "domain": {
            "oneOf": [
              { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              {
                "type": "object",
                "required": ["min", "max"],
                "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
              }
            ]
          },
          "phases": { "type": "array", "minItems": 1, "items": { "enum": ["P0", "D1"] } },
          "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "aggregation": {
      "type": "object",
      "required": ["escalateIf", "allowIf"],
      "properties": {
        "escalateIf": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "allowIf": { "type": "array", "items": { "$ref": "#/$defs/condition" } }
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": ["question"],
      "properties": {
        "question": { "type": "string" },
        "equals": { "type": "string" },
        "atLeast": { "type": "number" },
        "atMost": { "type": "number" },
        "minProbability": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
