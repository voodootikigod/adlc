{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/voodootikigod/adlc/packages/decision-layer/schemas/DecisionPack.schema.json",
  "title": "DecisionPack",
  "description": "A versioned question pack for @adlc/decision-layer (shadow mode). lib/pack.mjs validates the same rules without a schema engine, plus the cross-references a schema cannot express: question inputs must be declared, aggregation conditions must name a question and stay inside its domain, and question IDs must be unique, a Score domain min < max, and a pack file at most 64 KiB (checked before it is parsed).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "mode",
    "limits",
    "inputs",
    "questions",
    "aggregation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "maxLength": 64
    },
    "mode": {
      "const": "shadow"
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldBytes",
        "totalBytes"
      ],
      "properties": {
        "fieldBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        }
      }
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "A subset of the fields a v1 run collects; each declares that field's real source and type.",
      "properties": {
        "extensionCounts": {
          "allOf": [
            {
              "$ref": "#/$defs/input"
            },
            {
              "properties": {
                "source": {
                  "const": "git-diff"
                },
                "type": {
                  "const": "count-map"
                }
              }
            }
          ]
        },
        "linesAdded": {
          "allOf": [
            {
              "$ref": "#/$defs/input"
            },
            {
              "properties": {
                "source": {
                  "const": "git-diff"
                },
                "type": {
                  "const": "integer"
                }
              }
            }
          ]
        },
        "linesDeleted": {
          "allOf": [
            {
              "$ref": "#/$defs/input"
            },
            {
              "properties": {
                "source": {
                  "const": "git-diff"
                },
                "type": {
                  "const": "integer"
                }
              }
            }
          ]
        },
        "filesChanged": {
          "allOf": [
            {
              "$ref": "#/$defs/input"
            },
            {
              "properties": {
                "source": {
                  "const": "git-diff"
                },
                "type": {
                  "const": "integer"
                }
              }
            }
          ]
        },
        "ticketCategory": {
          "allOf": [
            {
              "$ref": "#/$defs/input"
            },
            {
              "properties": {
                "source": {
                  "const": "ticket-store"
                },
                "type": {
                  "const": "string"
                }
              }
            }
          ]
        },
        "declaredRailCount": {
          "allOf": [
            {
              "$ref": "#/$defs/input"
            },
            {
              "properties": {
                "source": {
                  "const": "ticket-store"
                },
                "type": {
                  "const": "integer-or-none"
                }
              }
            }
          ]
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "domain",
          "phases",
          "inputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "Choice",
              "Score",
              "Noul"
            ]
          },
          "prompt": {
            "type": "string",
            "maxLength": 512
          },
          "domain": {
            "description": "Bound to the kind by allOf below."
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "P0",
                "D1"
              ]
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "Choice"
                }
              }
            },
            "then": {
              "properties": {
                "domain": {
                  "$ref": "#/$defs/choiceDomain"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "Noul"
                }
              }
            },
            "then": {
              "properties": {
                "domain": {
                  "$ref": "#/$defs/noulDomain"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "Score"
                }
              }
            },
            "then": {
              "properties": {
                "domain": {
                  "$ref": "#/$defs/scoreDomain"
                }
              }
            }
          }
        ]
      }
    },
    "aggregation": {
      "type": "object",
      "required": [
        "escalateIf",
        "allowIf"
      ],
      "properties": {
        "escalateIf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "allowIf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "equals": {
          "type": "string"
        },
        "atLeast": {
          "type": "number"
        },
        "atMost": {
          "type": "number"
        },
        "minProbability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "description": "Choice or Noul: equals, no bounds",
          "required": [
            "equals"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "atLeast"
                ]
              },
              {
                "required": [
                  "atMost"
                ]
              }
            ]
          }
        },
        {
          "description": "Score: at least one bound, no equals",
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "atLeast"
                  ]
                },
                {
                  "required": [
                    "atMost"
                  ]
                }
              ]
            }
          ],
          "not": {
            "required": [
              "equals"
            ]
          }
        }
      ]
    },
    "choiceDomain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "noulDomain": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "yes",
          "no"
        ]
      }
    },
    "scoreDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "type",
        "classification",
        "maxBytes"
      ],
      "properties": {
        "source": {
          "enum": [
            "git-diff",
            "ticket-store"
          ]
        },
        "type": {
          "enum": [
            "integer",
            "string",
            "count-map",
            "integer-or-none"
          ]
        },
        "classification": {
          "const": "metadata"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    }
  }
}
