{
  "enabledPlugins": {
    "adlc@adlc": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/block-secret-exposure.mjs\"",
            "timeout": 10,
            "statusMessage": "checking for secret exposure"
          }
        ]
      }
    ]
  }
}
