# Enterprise contact form (/enterprise -> POST /api/contact).
# Copy to .env.local for development and set the real values in Vercel for prod.
# NEVER commit real values. Vercel BotID needs no secret — it is platform-native.

# Which sink receives leads: "attio" (default) or "resend" (fallback).
CONTACT_SINK=attio

# --- Attio sink (CONTACT_SINK=attio) ---
# Personal access token / API key from your Attio workspace settings.
ATTIO_API_TOKEN=
# Attribute API slugs on the standard People object for the extra fields.
# Defaults assume attributes named "company" and "message"; override to match
# your workspace schema.
ATTIO_COMPANY_ATTR=company
ATTIO_MESSAGE_ATTR=message

# --- Resend sink (CONTACT_SINK=resend) ---
# API key from resend.com; the from-address must be a verified domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=ADLC <noreply@agenticlifecycle.ai>
CONTACT_NOTIFY_EMAIL=chris@voodootikigod.com

# --- Route hardening ---
# Comma-separated origins allowed to POST the form. Set this in production to
# the site origin(s); if unset, the same-origin gate is disabled (BotID +
# honeypot + rate-limit still apply).
CONTACT_ALLOWED_ORIGINS=https://agenticlifecycle.ai
# Optional: used as the allowed origin when CONTACT_ALLOWED_ORIGINS is unset.
NEXT_PUBLIC_SITE_URL=https://agenticlifecycle.ai
