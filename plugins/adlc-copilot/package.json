{
  "name": "@adlc/copilot",
  "version": "1.6.0",
  "description": "Native ADLC plugin for the GitHub Copilot CLI: skills, hooks, MCP tools, and read-only prosecution agents.",
  "type": "module",
  "license": "MIT",
  "author": "Chris Williams (@voodootikigod)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voodootikigod/adlc.git",
    "directory": "plugins/adlc-copilot"
  },
  "homepage": "https://github.com/voodootikigod/adlc/tree/main/plugins/adlc-copilot#readme",
  "bugs": "https://github.com/voodootikigod/adlc/issues",
