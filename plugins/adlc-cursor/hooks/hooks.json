{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node ./hooks/adlc-pretool.mjs",
        "matcher": ".*",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "node ./hooks/adlc-audit.mjs",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./hooks/adlc-shell-advisory.mjs",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "node ./hooks/adlc-stop.mjs",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./hooks/adlc-preflight.mjs",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
